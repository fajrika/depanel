// Depanel — control panel for auto start/stop of depa VPS
generator client {
  provider = "prisma-client-js"
  // "native" for local dev; the musl target is for the Alpine Docker image.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Team members who can log into the panel.
model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         String        @default("member") // "admin" | "member"
  uiLayout     String        @default("topbar") // "topbar" | "sidebar"
  lastTeamId   String? // tim terakhir yang dipakai — dipulihkan saat login berikutnya
  active       Boolean       @default(true)
  totpSecret   String? // base32 TOTP secret (2FA) — null = belum diaktifkan
  totpEnabled  Boolean       @default(false)
  createdAt    DateTime      @default(now())
  activityLogs ActivityLog[]
  teams        TeamMember[]
}

/// A workspace: every user has one personal team; shared teams are created freely.
/// All depa accounts (and their servers), db-backup connections, and logs live inside a team.
model Team {
  id            String         @id @default(cuid())
  name          String
  isPersonal    Boolean        @default(false) // auto-created per user, cannot be deleted
  createdAt     DateTime       @default(now())
  lowBalanceThreshold Int? // rupiah; kirim notifikasi bila saldo aktual di bawah ini
  members       TeamMember[]
  accounts      DepaAccount[]
  dbConnections DbConnection[]
  sshConnections SshConnection[]
  sshGroups      SshGroup[]
  dbDests       DbDest[]
  activityLogs  ActivityLog[]
  notifyChannels NotifyChannel[]
  dirCloneJobs  DirCloneJob[]
}

/// A notification target for a team (Telegram, Discord, or generic webhook).
model NotifyChannel {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  type      String // "telegram" | "discord" | "webhook"
  label     String
  config    String // JSON: telegram {botToken,chatId} | discord/webhook {url}
  // event toggles
  onPower   Boolean  @default(true) // scheduler start/stop
  onBackup  Boolean  @default(true) // db backup success/failure
  onError   Boolean  @default(true) // server status error / sync failure
  onBalance Boolean  @default(true) // low balance
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Periodic metric + status sample for uptime/history (collected by the worker).
model MetricSample {
  id        String   @id @default(cuid())
  serverId  String
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  at        DateTime @default(now())
  status    String // canonical status at sample time
  cpu       Float? // % (from depa rrd last point)
  memPct    Float? // % memory used

  @@index([serverId, at])
}

model TeamMember {
  id             String             @id @default(cuid())
  teamId         String
  team           Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String             @default("member") // "owner" (tepat 1) | "admin" | "member"
  canViewBilling Boolean            @default(false) // member boleh melihat Saldo
  canViewCost    Boolean            @default(false) // member boleh melihat Biaya
  canViewReports Boolean            @default(false) // member boleh melihat Laporan
  canSchedule    Boolean            @default(true) // member boleh mengatur jadwal nyala-mati
  canBackup      Boolean            @default(true) // member boleh membuka/mengelola tab Backup
  canBackupDb    Boolean            @default(false) // member boleh membuka/mengelola Backup DB
  canSsh         Boolean            @default(false) // member boleh membuka/mengelola SSH Koneksi
  canInfra       Boolean            @default(false) // member boleh membuka halaman Infra
  canAccounts    Boolean            @default(false) // member boleh membuka/mengelola Akun API
  canNotify      Boolean            @default(false) // member boleh membuka halaman Notifikasi
  canFirewall    Boolean            @default(false) // member boleh mengakses tab Firewall
  canConsole     Boolean            @default(false) // member boleh mengakses tab Console
  canManage      Boolean            @default(false) // member boleh mengakses tab Kelola
  serverHides    MemberServerHide[]

  @@unique([teamId, userId])
}

/// Server yang DISEMBUNYIKAN dari member tertentu (default: semua server tim terlihat).
model MemberServerHide {
  id       String     @id @default(cuid())
  memberId String
  member   TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  serverId String
  server   Server     @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([memberId, serverId])
}

/// A depa cloud account, identified by its API key (stored encrypted).
/// Belongs to a team; the same key may be registered in several teams.
model DepaAccount {
  id           String   @id @default(cuid())
  teamId       String? // di-backfill lalu diwajibkan oleh kode (nullable demi migrasi SQLite)
  team         Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name         String // friendly label, e.g. "Depa Utama"
  apiKeyEnc    String // AES-256-GCM encrypted x-apikey
  active       Boolean  @default(true)
  lastSyncedAt DateTime?
  createdAt    DateTime @default(now())
  servers      Server[]
}

/// A VPS instance synced from the depa API.
model Server {
  id            String        @id @default(cuid())
  accountId     String
  account       DepaAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  uuid          String // depa instance uuid
  hostname      String
  status        String        @default("unknown") // running | stopped | ...
  location      String?
  tier          String?
  ipAddress     String?
  cpu           Int?
  memoryMb      Int?
  storageGb     Int?
  managed       Boolean       @default(false) // eligible for panel control + scheduling
  isProduction  Boolean       @default(false) // safety flag: never auto-stopped
  isActive      Boolean       @default(true) // server aktif di panel (bisa di-toggle per akun)
  sortOrder     Int           @default(0) // urutan tampil di daftar (diatur owner/admin)
  raw           String? // last raw JSON from depa (list endpoint)
  detailJson    String? // cached JSON from depa /detail endpoint
  detailSyncedAt DateTime? // when detailJson was fetched
  lastSyncedAt  DateTime?
  createdAt     DateTime      @default(now())
  schedule      Schedule?
  activityLogs  ActivityLog[]
  hiddenFor     MemberServerHide[]
  metricSamples MetricSample[]

  @@unique([accountId, uuid])
}

/// On/off schedule for a server (reconciliation-based).
model Schedule {
  id        String           @id @default(cuid())
  serverId  String           @unique
  server    Server           @relation(fields: [serverId], references: [id], onDelete: Cascade)
  enabled   Boolean          @default(true)
  timezone  String           @default("Asia/Jakarta")
  createdAt DateTime         @default(now())
  actions   ScheduleAction[]
}

/// A single weekly action: on the given days, at the given time, start or stop.
/// Desired state at any moment = the action most recently passed in the week.
model ScheduleAction {
  id         String   @id @default(cuid())
  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  days       String // comma-separated 0-6 (0=Sunday), e.g. "1,2,3,4,5"
  time       String // "HH:MM" local to schedule.timezone
  action     String // "start" | "stop"
}

/// A saved MySQL connection (credentials encrypted at rest). Team-scoped.
model DbConnection {
  id          String        @id @default(cuid())
  teamId      String?
  team        Team?         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name        String
  host        String
  port        Int           @default(3306)
  username    String
  passwordEnc String // AES-256-GCM encrypted
  sshId       String? // SSH jump host tunnel (optional)
  ssh         SshConnection? @relation(fields: [sshId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  jobs        DbBackupJob[]
}

/// A saved SSH jump-host connection (credentials encrypted at rest). Team-scoped.
model SshConnection {
  id                String        @id @default(cuid())
  teamId            String?
  team              Team?         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  groupId           String?
  group             SshGroup?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  name              String
  host              String
  port              Int           @default(22)
  username          String
  authType          String        @default("password") // "password" | "key"
  passwordEnc       String // AES-256-GCM encrypted (kosong bila authType = key)
  privateKeyEnc     String? // AES-256-GCM encrypted PEM private key (bila authType = key)
  keyPassphraseEnc  String? // AES-256-GCM encrypted passphrase (opsional)
  createdAt         DateTime      @default(now())
  dbConns           DbConnection[]
  metricSamples     SshMetricSample[]
  cloneSourceJobs   DirCloneJob[] @relation("DirCloneSource")
  cloneDestJobs     DirCloneJob[] @relation("DirCloneDest")
}

/// Grouping container for SSH connections. Team-scoped, 1 level only.
model SshGroup {
  id            String          @id @default(cuid())
  teamId        String?
  team          Team?           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name          String
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
  connections   SshConnection[]

  @@unique([teamId, name])
}

/// Periodic metric/status sample of an SSH-connected server (collected by the worker).
/// Values are parsed from read-only /proc + standard utilities on the remote host.
model SshMetricSample {
  id           String        @id @default(cuid())
  sshId        String
  ssh          SshConnection @relation(fields: [sshId], references: [id], onDelete: Cascade)
  at           DateTime      @default(now())
  ok           Boolean // false bila koneksi/eksekusi gagal (error diisi)
  error        String? // pesan kegagalan (bila ok = false)
  hostname     String?
  osName       String? // e.g. "Ubuntu 22.04.3 LTS"
  kernel       String? // e.g. "6.2.0-1017-azure"
  cpu          Float? // % CPU terpakai (delta /proc/stat)
  cpuCores     Int? // jumlah core CPU (nproc)
  memPct       Float? // % RAM terpakai
  memUsedMb    Int? // RAM terpakai (MiB)
  memTotalMb   Int? // total RAM (MiB)
  load1        Float?
  load5        Float?
  load15       Float?
  uptimeSec    Int?
  netInBps     Float? // kecepatan download (byte/s)
  netOutBps    Float? // kecepatan upload (byte/s)
  disk         String? // JSON [{mount,sizeMb,usedMb,pct}]
  topProcs     String? // JSON [{pid,user,cpu,mem,comm}] top 10
  ports        String? // JSON [{proto,port}] listening
  failedSvcs   String? // JSON [name] service systemd gagal

  @@index([sshId, at])
}

/// A scheduled MySQL backup job.
model DbBackupJob {
  id           String       @id @default(cuid())
  connectionId String
  connection   DbConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  name         String
  databases    String // JSON array of database names
  scheduleType String // "daily" | "weekly" | "monthly" | "cron"
  timeAt       String? // "HH:MM" for daily/weekly/monthly
  dayOn        Int? // weekly: 0-6 (0=Sunday); monthly: 1-28 (tanggal)
  cronExpr     String? // for scheduleType "cron"
  timezone     String       @default("Asia/Jakarta")
  destType     String // "local" | "ftp" | "s3" | "gdrive"
  destId       String?
  dest         DbDest?      @relation(fields: [destId], references: [id], onDelete: SetNull)
  destPath     String? // folder per job: local path / ftp folder / s3 prefix / gdrive folderId
  retention    Int          @default(0) // 0 = keep all, N = keep last N backups
  compression  String       @default("brotli") // none | gzip | brotli | xz | xz_extreme
  enabled      Boolean      @default(true)
  lastRunAt    DateTime?
  lastStatus   String? // "success" | "failed" | "running"
  createdAt    DateTime     @default(now())
  runs         DbBackupRun[]
}

/// A backup destination connection (FTP / S3 / GDrive). Credentials only —
/// the target folder/path stays on the job (DbBackupJob.destPath).
model DbDest {
  id        String       @id @default(cuid())
  teamId    String?
  team      Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  type      String // "ftp" | "s3" | "gdrive"
  name      String
  config    String // JSON config; secret fields encrypted (incl. GDrive OAuth tokens)
  createdAt DateTime     @default(now())
  jobs      DbBackupJob[]
}

/// One execution of a backup job.
model DbBackupRun {
  id        String      @id @default(cuid())
  jobId     String
  job       DbBackupJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status    String      @default("running") // running | success | failed
  message   String?
  sizeBytes Int? // ukuran file terkompresi
  sqlSizeBytes Int? // ukuran SQL asli (sebelum kompresi)
  location  String? // final path/URL of the backup file
  startedAt DateTime    @default(now())
  endedAt   DateTime?

  @@index([jobId, startedAt])
}

/// One execution of a restore operation (async, polled by client).
model DbRestoreRun {
  id        String   @id @default(cuid())
  teamId    String?
  userId    String?
  runId     String   // DbBackupRun.id being restored
  targetConnId String?
  status    String   @default("running") // running | success | failed
  message   String?
  warnings  String?  // JSON array of warning strings
  progressPct  Int?      // 0-100
  progressText String?   // e.g. "Memulihkan data di audits (24/154)"
  startedAt DateTime @default(now())
  endedAt   DateTime?

  @@index([id])
}

/// A scheduled clone of a directory from an SSH server to a destination
/// (local path on the panel host / Google Drive / another SSH server).
/// Like DbBackupJob, the schedule is driven by the worker every minute.
model DirCloneJob {
  id           String        @id @default(cuid())
  teamId       String?
  team         Team?         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name         String
  sourceSshId  String
  sourceSsh    SshConnection @relation("DirCloneSource", fields: [sourceSshId], references: [id], onDelete: Cascade)
  sourcePath   String // direktori absolut di server sumber, mis. /var/www/html
  destType     String // "local" | "gdrive" | "ssh"
  destSshId    String? // untuk destType "ssh"
  destSsh      SshConnection? @relation("DirCloneDest", fields: [destSshId], references: [id], onDelete: SetNull)
  destGdriveId String? // DbDest.id (type "gdrive") untuk destType "gdrive"
  destPath     String? // path lokal di host / folder GDrive (folderId) / path tujuan di server SSH
  scheduleType String        @default("manual") // manual | daily | weekly | monthly | cron
  timeAt       String? // "HH:MM" untuk daily/weekly/monthly
  dayOn        Int? // weekly: 0-6 (0=Sunday); monthly: 1-28
  cronExpr     String? // untuk scheduleType "cron"
  timezone     String        @default("Asia/Jakarta")
  retention    Int           @default(0) // 0 = simpan semua, N = simpan N run terakhir
  enabled      Boolean       @default(true)
  lastRunAt    DateTime?
  lastStatus   String? // "success" | "failed" | "running"
  createdAt    DateTime      @default(now())
  runs         DirCloneRun[]
}

/// One execution of a directory clone job.
model DirCloneRun {
  id        String      @id @default(cuid())
  jobId     String
  job       DirCloneJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status    String      @default("running") // running | success | failed
  message   String?
  sizeBytes Int? // ukuran file .tar.gz
  location  String? // path/URL hasil clone
  startedAt DateTime    @default(now())
  endedAt   DateTime?

  @@index([jobId, startedAt])
}

/// Audit trail: who did what, when (userId null = scheduler/system). Team-scoped.
model ActivityLog {
  id        String   @id @default(cuid())
  teamId    String?
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  serverId  String?
  server    Server?  @relation(fields: [serverId], references: [id], onDelete: SetNull)
  action    String // start | stop | restart | sync | schedule_apply | login
  source    String   @default("web") // web | scheduler
  status    String   @default("success") // success | failed
  message   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
